# 服务端配置。复制为 .env 后修改；.env 已在 .gitignore 中。
PASSWORD=change-me
# PROXY_SECRET=请用 `openssl rand -hex 32` 生成；不设置时由 PASSWORD 派生
LISTEN=:8080
DATA_DIR=./data
CACHE_DB=./data/cache.db
# 观看进度/收藏（独立于缓存，不能与 CACHE_DB 相同）
USER_DB=./data/userdata.db
SOURCES_FILE=./configs/sources.json
LOG_LEVEL=info

# 搜索
# SEARCH_MAX_PAGES=5
# 快速模式默认只查健康度最好的 N 个源；0 表示禁用快速模式
# SEARCH_FAST_SOURCES=8
# SEARCH_SOURCE_TIMEOUT_MS=6000
# SEARCH_SOFT_DEADLINE_MS=1200
# SEARCH_HARD_DEADLINE_MS=6000
# SEARCH_CACHE_TTL_MS=300000

# 详情/代理
# REQUEST_TIMEOUT=8000

# 画质探测
# QUALITY_CONCURRENCY=3
# QUALITY_TIMEOUT_MS=8000

# 直播：自建内网 IPTV 时开启
# LIVE_PROBE_CONCURRENCY=16
# LIVE_TIMEOUT_MS=10000

# 源配置持久化（首次启动从 SOURCES_FILE 导入一次，之后以数据库为准）
# SOURCES_DB=./data/sources.db
# 自动发现渠道（逗号分隔，默认内置两条 jsDelivr 源；每 7 天跑一次）
# DISCOVER_SOURCES=

# 媒体聚合与元数据刮削
# MEDIA_ENABLED=1
# MEDIA_DB=./data/media.db
# MEDIA_COVER_DIR=./data/covers
# MEDIA_COVER_BASE=/api/media
# 自动确认强匹配（标题+年份一致）；默认关闭，只给候选
# MEDIA_AUTO_CONFIRM=0
# TMDB 凭据（v3 API key 或 v4 读访问令牌，任一即可；都不填则跳过 TMDB）
# TMDB_API_KEY=
# TMDB_READ_TOKEN=
# 默认 api.tmdb.org：国内 api.themoviedb.org 被 DNS 污染
# TMDB_API_BASE=https://api.tmdb.org

# 推荐（60s API 实例）
# 60S_API_BASE=https://60s.crystelf.top
# RECOMMEND_TIMEOUT_MS=10000
# LIVE_ALLOW_PRIVATE=1

# Web 开发时跨域；生产同源部署可留空
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
