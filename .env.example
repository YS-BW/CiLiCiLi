# 服务端配置。复制为 .env 后修改；.env 已在 .gitignore 中。
PASSWORD=change-me
# PROXY_SECRET=请用 `openssl rand -hex 32` 生成；不设置时由 PASSWORD 派生
LISTEN=:8080
DATA_DIR=./data
CACHE_DB=./data/cache.db
SOURCES_FILE=./configs/sources.json
LOG_LEVEL=info

# 搜索
# SEARCH_MAX_PAGES=5
# 快速模式默认只查健康度最好的 N 个源；0 表示禁用快速模式
# SEARCH_FAST_SOURCES=8
# SEARCH_SOURCE_TIMEOUT_MS=6000
# SEARCH_SOFT_DEADLINE_MS=1200
# SEARCH_HARD_DEADLINE_MS=6000
# SEARCH_CACHE_TTL_MS=300000

# 详情/代理
# REQUEST_TIMEOUT=8000

# 直播：自建内网 IPTV 时开启
# LIVE_ALLOW_PRIVATE=1

# Web 开发时跨域；生产同源部署可留空
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
