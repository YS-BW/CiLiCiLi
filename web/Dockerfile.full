# CiLiCiLi Web 完整自包含镜像：多阶段 node 构建 → nginx 托管。
# 需要构建机可访问 npm 源（CI / VPS / 有外网环境）。
FROM node:22-alpine AS build
WORKDIR /app
ENV NPM_CONFIG_FUND=false NPM_CONFIG_AUDIT=false CI=true
COPY package.json package-lock.json* ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY docker-entrypoint.sh /docker-entrypoint.d/40-substitute-upstream.sh
RUN chmod +x /docker-entrypoint.d/40-substitute-upstream.sh
COPY --from=build /app/dist /usr/share/nginx/html
ENV BACKEND_UPSTREAM=http://backend:8080
EXPOSE 80
